{
  "name": "expense-tracker",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @expense/web --filter @expense/api dev",
    "dev:web": "pnpm --filter @expense/web dev",
    "dev:api": "pnpm --filter @expense/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @expense/api prisma:generate",
    "db:migrate": "pnpm --filter @expense/api prisma:migrate",
    "db:studio": "pnpm --filter @expense/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
